generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OfferStatus {
  NEW
  APPROVED
  REJECTED
  QUEUED
  PUBLISHED
  EXPIRED
}

enum PublicationStatus {
  DRAFT
  SCHEDULED
  PROCESSING
  PUBLISHED
  FAILED
  CANCELLED
}

model Marketplace {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  status    String    @default("ACTIVE")
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id                String                @id @default(cuid())
  marketplaceId     String
  externalId        String
  title             String
  description       String?
  category          String?
  sellerName        String?
  productUrl        String
  imageUrl          String?
  currentPrice      Decimal               @db.Decimal(12, 2)
  originalPrice     Decimal?              @db.Decimal(12, 2)
  discountPercent   Int?
  rating            Decimal?              @db.Decimal(3, 2)
  salesCount        Int?
  commissionRate    Decimal?              @db.Decimal(6, 2)
  commissionValue   Decimal?              @db.Decimal(12, 2)
  metadata          Json?
  firstSeenAt       DateTime              @default(now())
  lastSeenAt        DateTime              @default(now())
  marketplace       Marketplace           @relation(fields: [marketplaceId], references: [id])
  offers            Offer[]
  priceHistory      ProductPriceHistory[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([marketplaceId, externalId])
}

model ProductPriceHistory {
  id         String   @id @default(cuid())
  productId  String
  price      Decimal  @db.Decimal(12, 2)
  capturedAt DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, capturedAt])
}

model Offer {
  id                String        @id @default(cuid())
  productId         String
  currentPrice      Decimal       @db.Decimal(12, 2)
  originalPrice     Decimal?      @db.Decimal(12, 2)
  discountPercent   Int?
  commissionRate    Decimal?      @db.Decimal(6, 2)
  commissionValue   Decimal?      @db.Decimal(12, 2)
  affiliateUrl      String?
  couponCode        String?
  couponDescription String?
  score             Int
  status             OfferStatus   @default(NEW)
  detectedAt         DateTime      @default(now())
  expiresAt          DateTime?
  product            Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  publications       Publication[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([status, detectedAt])
}

model Channel {
  id                  String        @id @default(cuid())
  type                String
  name                String
  externalId          String?
  category            String?
  marketplaceFilter   String?
  minIntervalSeconds  Int           @default(300)
  maxPostsPerHour     Int           @default(8)
  allowedStartTime    String?
  allowedEndTime      String?
  status              String        @default("ACTIVE")
  metadata            Json?
  publications        Publication[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model Publication {
  id            String            @id @default(cuid())
  offerId       String
  channelId     String
  content       String
  imageUrl      String?
  scheduledAt   DateTime?
  publishedAt   DateTime?
  status        PublicationStatus @default(DRAFT)
  errorMessage  String?
  offer         Offer             @relation(fields: [offerId], references: [id], onDelete: Cascade)
  channel       Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  clicks        Click[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status, scheduledAt])
}

model Click {
  id            String       @id @default(cuid())
  offerId       String
  publicationId String
  channelId     String
  timestamp     DateTime     @default(now())
  metadata      Json?
  publication   Publication  @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@index([publicationId, timestamp])
}

model EventLog {
  id        String   @id @default(cuid())
  entityId  String?
  event     String
  metadata  Json?
  error     String?
  createdAt DateTime @default(now())

  @@index([event, createdAt])
}
